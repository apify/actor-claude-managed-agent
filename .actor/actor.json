{
    "actorSpecification": 1,
    "name": "claude-agent",
    "title": "Claude Agent with MCP Connectors",
    "description": "Run a Claude Managed Agent on Apify with user-selected MCP connectors. Clones a developer-defined template Agent at runtime and wires in mcp.apify.com plus any requested Apify connectors.",
    "version": "0.0",
    "buildTag": "latest",
    "input": "./input_schema.json",
    "dockerfile": "./Dockerfile",
    "categories": ["AI"],
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Agent task results",
            "views": {
                "overview": {
                    "title": "Overview",
                    "display": {
                        "component": "table",
                        "properties": {
                            "answer":        { "label": "Answer",         "format": "text" },
                            "agentId":       { "label": "Agent ID",       "format": "text" },
                            "sessionId":     { "label": "Session ID",     "format": "text" },
                            "environmentId": { "label": "Environment ID", "format": "text" },
                            "durationMs":    { "label": "Duration (ms)",  "format": "number" },
                            "finishedAt":    { "label": "Finished At",    "format": "date" }
                        }
                    }
                }
            }
        }
    }
}

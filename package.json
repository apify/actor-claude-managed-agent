{
    "name": "claude-agent-actor",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "description": "Apify Actor that runs a Claude Managed Agent with dynamically-selected MCP connectors.",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.0.9",
    "scripts": {
        "build": "tsc",
        "start": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "apify": "^3.5.0"
    },
    "devDependencies": {
        "@types/node": "24.12.3",
        "tsx": "4.21.0",
        "typescript": "5.9.3"
    }
}
